{
  "name": "agents-on-contract-bank",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "check": "hardhat test && tsc --noEmit -p services && pnpm --filter dashboard check && hardhat run scripts/scenarios.ts",
    "check:base-sepolia": "export BASE_SEPOLIA_RPC_URL=${BASE_SEPOLIA_RPC_URL:-https://sepolia.base.org} && hardhat test solidity --test-profile baseSepolia --chain-type op --grep-exclude invariant_ && hardhat run scripts/probe-chain.ts --network baseSepolia",
    "scenarios": "hardhat run scripts/scenarios.ts",
    "demo": "hardhat run scripts/demo.ts --network localhost",
    "record": "hardhat run scripts/record.ts",
    "record:base-sepolia": "export BASE_SEPOLIA_RPC_URL=${BASE_SEPOLIA_RPC_URL:-https://sepolia.base.org} && hardhat run scripts/record.ts --network baseSepolia",
    "verify:base-sepolia": "export BASE_SEPOLIA_RPC_URL=${BASE_SEPOLIA_RPC_URL:-https://sepolia.base.org} && hardhat run scripts/verify.ts --network baseSepolia"
  },
  "devDependencies": {
    "@bank/services": "workspace:*",
    "@nomicfoundation/hardhat-verify": "3.1.2",
    "forge-std": "github:foundry-rs/forge-std#v1.11.0",
    "hardhat": "3.18.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@openzeppelin/community-contracts": "github:OpenZeppelin/openzeppelin-community-contracts#2add94e5b7ce9d040ae5f6c80b6082e8159002da",
    "@openzeppelin/contracts": "5.7.0"
  }
}
